---
import { Image } from 'astro:assets';
import { asset } from '../lib/images';
import { imageCaption } from '../lib/caption';
import { href, t, type Locale } from '../i18n/ui';
import { categoryLabel, inventoryPath } from '../lib/modules';
import '../styles/inventory.css';

interface Props {
  module: Record<string, any>;
  locale: Locale;
}

const { module: mod, locale } = Astro.props;
const tr = t(locale);
const content = mod.i18n[locale];
const backHref = href(locale, inventoryPath(mod.category));
const allHref = href(locale, 'inventory');
---

<header class="inventory-header">
  <div class="header-container">
    <div class="header-copy">
      <nav class="detail-breadcrumb" aria-label="breadcrumb">
        <a href={allHref}>{tr('inventory.title')}</a>
        <span aria-hidden="true">/</span>
        <a href={backHref}>{categoryLabel(mod.category)}</a>
        <span aria-hidden="true">/</span>
        <span>{content.title}</span>
      </nav>
      <p class="detail-kicker"># {mod.number} · {mod.name}</p>
      <h1>{content.title}</h1>
      <p class="header-sub">{content.desc}</p>
      <div class="tag-list detail-tags">
        {mod.tags.map((tag: string) => <span class="tag">{tag}</span>)}
      </div>
    </div>
    <div class="header-right">
      <a class="back-link" href={backHref}>{tr('inventory.back')}</a>
    </div>
  </div>
</header>

<main class="module-detail-page">
  <section class="section-block">
    <h2>{tr('inventory.section.photos')}</h2>
    <div class="gallery-grid">
      {
        mod.images.map((img: string) => {
          const file = img.split('/').pop()!;
          return (
            <button
              type="button"
              class="gallery-img-wrap"
              data-full={asset(img).src}
              data-caption={imageCaption(file, locale)}
              data-filename={file}
            >
              <Image src={asset(img)} alt={file} widths={[400, 800]} loading="lazy" />
            </button>
          );
        })
      }
    </div>
  </section>

  <section class="section-block">
    <h2>{tr('inventory.section.specs')}</h2>
    <table class="wiring-table">
      <tbody>
        {
          content.specs.map((s: { label: string; val: string }) => (
            <tr>
              <td style="width: 30%; color: var(--text-secondary);">{s.label}</td>
              <td>{s.val}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  {
    content.raspberryPiPinoutGuide && (
      <section class="section-block">
        <h2>{content.raspberryPiPinoutGuide.title}</h2>
        {
          content.raspberryPiPinoutGuide.image && (
            <div class="pinout-image-container">
              <Image 
                src={asset(content.raspberryPiPinoutGuide.image)} 
                alt="Raspberry Pi GPIO Pinout"
                widths={[600, 1000]}
                loading="lazy"
              />
            </div>
          )
        }
        {
          content.raspberryPiPinoutGuide.wiringTable && (
            <table class="wiring-table">
              <thead>
                <tr>
                  <th>Physical Pin</th>
                  <th>GPIO Function</th>
                  <th>HC-SR04 Use</th>
                </tr>
              </thead>
              <tbody>
                {content.raspberryPiPinoutGuide.wiringTable.map((row: any) => (
                  <tr>
                    <td>{row.pin}</td>
                    <td>{row.gpio}</td>
                    <td style="color: var(--text-highlight);">{row.use}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )
        }
      </section>
    )
  }

  {
    (
      [
        ['raspberryPiWiring', 'inventory.section.raspberryPi'],
        ['arduinoWiring', 'inventory.section.arduino'],
        ['stm32Wiring', 'inventory.section.stm32'],
      ] as const
    ).map(([key, labelKey]) =>
      content[key]?.length ? (
        <section class="section-block">
          <h2>{tr(labelKey)}</h2>
          <table class="wiring-table">
            <thead>
              <tr>
                <th>{tr('inventory.wiring.pin')}</th>
                <th>{tr('inventory.wiring.conn')}</th>
              </tr>
            </thead>
            <tbody>
              {content[key].map((w: { pin: string; conn: string }) => (
                <tr>
                  <td>{w.pin}</td>
                  <td>{w.conn}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      ) : null,
    )
  }

  {
    content.codeSnippet && (
      <section class="section-block">
        <h2>{tr('inventory.section.code')}</h2>
        <div class="code-block">{content.codeSnippet}</div>
      </section>
    )
  }
</main>

<div class="lightbox-overlay" id="lightbox-overlay">
  <button class="lightbox-close-btn" id="lightbox-close" aria-label="close">&times;</button>
  <div class="lightbox-img-container">
    <img id="lightbox-img" src="" alt="" />
  </div>
  <div class="lightbox-caption-bar">
    <h4 id="lightbox-caption-type"></h4>
    <p id="lightbox-caption-filename"></p>
  </div>
</div>

<script>
  const lightbox = document.getElementById('lightbox-overlay')!;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const captionType = document.getElementById('lightbox-caption-type')!;
  const captionFile = document.getElementById('lightbox-caption-filename')!;

  function closeLightbox() {
    lightbox.classList.remove('active');
  }

  document.querySelectorAll<HTMLElement>('.gallery-img-wrap').forEach((wrap) => {
    wrap.addEventListener('click', () => {
      img.src = wrap.dataset.full ?? '';
      captionType.textContent = wrap.dataset.caption ?? '';
      captionFile.textContent = wrap.dataset.filename ?? '';
      lightbox.classList.add('active');
    });
  });

  document.getElementById('lightbox-close')!.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>

<style>
  .detail-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
    margin-bottom: 0.75rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .detail-breadcrumb a {
    color: var(--accent-cyan);
    text-decoration: none;
  }

  .detail-kicker {
    color: var(--accent-indigo);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .detail-tags {
    margin-top: 1rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1rem;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    color: var(--text-primary);
    text-decoration: none;
    background: var(--bg-card);
  }

  .module-detail-page {
    max-width: 960px;
    margin: 0 auto 4rem;
    padding: 0 2rem;
  }

  .module-detail-page .section-block {
    margin-top: 2rem;
  }

  .module-detail-page h2 {
    margin-bottom: 0.85rem;
    font-size: 1.15rem;
  }

  .gallery-img-wrap {
    appearance: none;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: zoom-in;
    text-align: left;
  }
</style>
