---
import Base from '../../../layouts/Base.astro';
import InventoryList from '../../../components/InventoryList.astro';
import { t } from '../../../i18n/ui';
import { listingCategories } from '../../../lib/modules';

export function getStaticPaths() {
  return listingCategories.map((c) => ({ params: { category: c.key } }));
}

const category = Astro.params.category!;
const tr = t('en');
---

<Base
  locale="en"
  page="inventory"
  title={`${tr('inventory.title')} | ${tr('site.title')}`}
>
  <InventoryList locale="en" category={category} />
</Base>
